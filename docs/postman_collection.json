    {
      "name": "Idempotency",
      "item": [
        {
          "name": "Replay with Same Key and Body",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "idempotent-test-unique-key" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Idempotent Task\",\n  \"description\": \"Testing replayed header\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", ""]
            }
          }
        },
        {
          "name": "Key Reused with Different Body (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "idempotent-test-unique-key" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Different Body\",\n  \"description\": \"Will conflict with original key payload\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Filtering, Search and Ordering",
      "item": [
        {
          "name": "Combined Query",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/?completed=false&priority=high&due_before=2026-12-31&search=rent&ordering=due_date&page=1&page_size=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", ""],
              "query": [
                { "key": "completed", "value": "false" },
                { "key": "priority", "value": "high" },
                { "key": "due_before", "value": "2026-12-31" },
                { "key": "search", "value": "rent" },
                { "key": "ordering", "value": "due_date" },
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Out of Range Page (404)",
          "request": {
            "method": "GET",
