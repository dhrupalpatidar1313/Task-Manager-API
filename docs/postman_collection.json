{
  "info": {
    "name": "Task Manager API",
    "_postman_id": "c1f1088d-71b3-462a-a957-6dbd0879e951",
    "description": "Postman Collection for the Natural-language Task Manager API with strict validation, idempotency, and subtask hierarchy support.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Tasks CRUD",
      "item": [
        {
          "name": "List Tasks (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/?page=1&page_size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", ""],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "demo-create-task-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Submit quarterly report\",\n  \"description\": \"Compile metrics and share with team lead\",\n  \"completed\": false,\n  \"due_date\": \"2026-12-15\",\n  \"priority\": \"high\",\n  \"recurrence\": \"monthly\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", ""]
            }
          }
        },
        {
          "name": "Retrieve Task by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", ""]
            }
          }
        },
        {
          "name": "Update Task (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Submit updated quarterly report\",\n  \"description\": \"Includes Q4 audit metrics\",\n  \"completed\": true,\n  \"due_date\": \"2026-12-20\",\n  \"priority\": \"medium\",\n  \"recurrence\": \"monthly\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", ""]
            }
          }
        },
        {
          "name": "Update Task Partially (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"low\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", ""]
            }
          }
        },
        {
          "name": "Delete Task (Cascade Subtasks)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}", ""]
            }
          }
        }
      ]
    },
